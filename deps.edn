{:paths ["src" "resources"]
 ;; tools.deps reads :mvn/repos ONLY from the project it is invoked on, never from a
 ;; dependency. JitPack hosts sherpa-onnx, which the engine pulls in under the :test alias.
 :mvn/repos {"jitpack" {:url "https://jitpack.io"}}
 :deps {com.blockether/vis-contract {:mvn/version "RELEASE"}}
 ;; The engine is a DEVELOPMENT dependency only: a pack is compiled INTO vis, so
 ;; depending on it at runtime would make the dependency circular. Aliases are not
 ;; transitive, which is what keeps that true for anyone who pins this library.
 :aliases {:test {:extra-deps
                  {com.blockether/vis {:git/sha "754e85fe4d0f1dec4d4f630127869aefe3c1e331"
                                       :git/url "https://github.com/Blockether/vis.git"}
                   ;; The engine compiles against packages/vis-contract, whose published
                   ;; RELEASE jar can lag it. Pin the same source tree for the test run.
                   com.blockether/vis-contract {:deps/root "packages/vis-contract"
                                                :git/sha "754e85fe4d0f1dec4d4f630127869aefe3c1e331"
                                                :git/url "https://github.com/Blockether/vis.git"}
                   io.github.noahtheduke/lazytest {:mvn/version "2.1.0"}}
                  :extra-paths ["test"]
                  :main-opts ["-m" "lazytest.main" "--dir" "test"]}}}
